# Django Core Settings
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key
DEBUG=False
ALLOWED_HOSTS=api.careconnect.com,careconnect.com,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://admin.careconnect.com,https://careconnect.com

# PostgreSQL Database
DATABASE_URL=postgres://postgres_user:postgres_password@postgres_host:5432/careconnect_db
DB_NAME=careconnect_db
DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_HOST=postgres_host
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis_host:6379/0
CELERY_BROKER_URL=redis://redis_host:6379/0
CELERY_RESULT_BACKEND=redis://redis_host:6379/0

# SMTP Email Setup
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@careconnect.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CareConnect <noreply@careconnect.com>
